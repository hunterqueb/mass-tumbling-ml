clear;clc;

dt = 0.01;
tf = 10;
N = tf/dt;
% Example usage (you plug your own data):
t = linspace(0,10,N);                  % Nx1


Q_est =  [[ 0.3868  0.0468  0.0886]
 [ 0.0468  0.3694 -0.1004]
 [ 0.0886 -0.1004  0.2439]];

% Optional: initial guess for principal moments
J_true = 100* [[ 0.3905  0.0567  0.1052]
 [ 0.0567  0.3803 -0.115 ]
 [ 0.1052 -0.115   0.2292]];            % whatever prior you have

[~, I_true] = eig(100* [[ 0.3905  0.0567  0.1052]
[ 0.0567  0.3803 -0.115 ]
[ 0.1052 -0.115   0.2292]]);


omega_b = zeros(N,3);
omega   = [0.1; 0.05; -0.02];  % initial angular rate in body frame

for k = 1:N-1

    % Here we assume Q_est is the principal frame of the *true* inertia for demo.
    % In your application, Q_est is fixed and I_true is unknown.
    % Dynamics in body frame: I*dot(omega) + omega x (I*omega) = tau
    Iw    = I_true * omega;
    domega = I_true \ ( -cross(omega, Iw));

    omega = omega + domega*dt;
    omega_b(k+1,:) = omega.';
end

[lam, I_0] = eig(100* [[ 0.3905  0.0567  0.1052]
[ 0.0567  0.3803 -0.115 ]
[ 0.1052 -0.115   0.2292]]);

I_0_vec= [I_0(1),I_0(2),I_0(3)];
I_true_vec= [I_true(1),I_0(2),I_0(3)];

[I_opt, J_opt, info] = estimateInertiaTorqueFree(t, omega_b, Q_est, I_0_vec);

disp('Identified principal inertias:');
disp(I_opt);

disp("True princiapl inertias")
disp(I_true_vec);

disp('Identified inertia matrix in body frame:');
disp(J_opt);

disp("True Inertia Matrix in body frame");
disp(J_true)